      "input": {
        "event": "EPO:R71(3)",
        "documentDate": "2025-09-30",
        "receivedAt": null
      },
      "expect": {
        "ok": true,
        "due": "2026-01-30",
        "trace": [
          {
            "op": "delivery",
            "from": "2025-09-30",
            "to": "2025-09-30",
            "cite": "Rule 126(2) EPC; OJ EPO 2023, A29"
          },
          {
            "op": "start",
            "from": "2025-09-30",
            "to": "2025-10-01",
            "cite": "Rule 131(2) EPC"
          },
          {
            "op": "add-period",
            "from": "2025-09-30",
            "to": "2026-01-30",
            "cite": "Rule 71(3) EPC; Rule 131(4) EPC"
          },
          {
            "op": "closure-roll",
            "from": "2026-01-30",
            "to": "2026-01-30",
            "cite": "Rule 134(1) EPC; OJ EPO 2025, A40"
          }
        ],
        "notes": [],
        "remedies": []
      }
